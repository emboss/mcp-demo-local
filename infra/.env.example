# Kopieren nach infra/.env und BEIDE Passwörter durch eigene Werte ersetzen.
# Nur Buchstaben, Ziffern und Bindestriche verwenden (die Werte landen in einer Verbindungs-URL).

# Superuser der Datenbank - nur der NAIVE Server nutzt ihn (genau das ist das Problem).
POSTGRES_PASSWORD=bitte-aendern-superuser

# Eingeschränkte Rolle hr_mcp - nur der GEHÄRTETE Server nutzt sie.
HR_MCP_DB_PASSWORD=bitte-aendern-hr-mcp
